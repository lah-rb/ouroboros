{
  "interactive_prompt": "",
  "py": {
    "install_command": [
      "uv",
      "pip",
      "install",
      "-r",
      "pyproject.toml"
    ],
    "formatter": [
      "ruff",
      "format",
      "-q",
      "{file}"
    ],
    "syntax": [
      "python",
      "-c",
      "import py_compile; py_compile.compile('{file}', doraise=True)"
    ],
    "import": [
      "python",
      "-c",
      "import {module}"
    ],
    "cross_import": [
      "python",
      "-c",
      "from {module} import *"
    ],
    "lint": [
      "ruff",
      "check",
      "--fix",
      "{file}"
    ]
  },
  "toml": {
    "syntax": [
      "python",
      "-c",
      "import tomllib; tomllib.load(open('{file}', 'rb'))"
    ]
  },
  "yaml": {
    "syntax": [
      "python",
      "-c",
      "import yaml; yaml.safe_load(open('{file}'))"
    ]
  },
  "md": {
    "syntax": [
      "python",
      "-c",
      "import markdown; markdown.markdown(open('{file}').read())"
    ]
  }
}